# 本地：复制成 .streamlit/secrets.toml 再填（该文件已被 .gitignore 忽略）
# 云端：Streamlit Cloud → 你的 app → Settings → Secrets，把下面几行粘进去
#
# 注意：这里不需要、也不建议放 API_KEY。
# 这个应用是「谁用谁填自己的 Key」：每位访客在侧边栏贴自己的 Key，
# 站点不提供公共额度，所以站长就算把 Key 写进 Secrets 也不会有访客用到它。
# 下面两行是可选的默认值：访客打开时 BASE_URL 和模型名已经填好，只需贴 Key。
BASE_URL = "https://api-inference.modelscope.cn/v1"
MODEL_NAME = "deepseek-ai/DeepSeek-V4-Pro"
